{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u3086\u3093\u306e\u30d6\u30ed\u30b0","text":"<p>Twitter\u306b\u66f8\u304f\u306b\u306f\u9577\u3059\u304e\u308b\u304c\uff0c\u30cb\u30b3\u30cb\u30b3\u306b\u6295\u7a3f\u3059\u308b\u307b\u3069\u3067\u306f\u306a\u3044\u601d\u3044\u4ed8\u304d\u3092\u8f09\u305b\u308b\u30d6\u30ed\u30b0\uff0e</p> <p>ProperDocs\u306b\u3088\u3063\u3066\u4f5c\u3089\u308c\u3066\u3044\u307e\u3059\uff0e</p>"},{"location":"#_2","title":"\u6700\u8fd1\u306e\u8a18\u4e8b","text":"<p>2\u4ef6\u307e\u3067\u63b2\u8f09\u3057\u307e\u3059\uff0e</p> <p>\u4e00\u89a7\u306f\u3053\u3061\u3089\u3092\u53c2\u7167\uff0e</p> \u30bf\u30a4\u30c8\u30eb \u65e5\u6642 \u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u793e\u4f1a\u5951\u7d04 2026/09/23 \u306f\u308d\u30fc\u308f\u30fc\u308b\u3069 2026/09/22"},{"location":"#_3","title":"\u3086\u3093\u306b\u3064\u3044\u3066","text":"<p>\u3053\u3061\u3089\u3092\u53c2\u7167\uff0e</p>"},{"location":"about-me/","title":"\u3086\u3093\u306b\u3064\u3044\u3066","text":"<p>C++\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u3072\u3068\uff0e</p> <p>\u3042\u308b\u3044\u306fC++er\u304b\u3064\u30dc\u30a4\u30b9\u30ed\u30a4\u30c0\u30fc<sup>1</sup>\uff0e</p>"},{"location":"about-me/#_2","title":"\u6d3b\u52d5\u5185\u5bb9","text":"\u5834\u6240 \u30a2\u30ab\u30a6\u30f3\u30c8 \u3084\u3063\u3066\u308b\u3053\u3068 \u30cb\u30b3\u30cb\u30b3\u52d5\u753b \u3086\u3093 \u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u5287\u5834\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u89e3\u8aac\u3092\u4e0d\u5b9a\u671f\u306b\u6295\u7a3f Twitter (X) \u3086\u3093 (@yun_cpp_v) \u3060\u3089\u3060\u3089\u558b\u3063\u3066\u308b Qiita \u3086\u3093 (@yun-cpp-v) C++\u306b\u3064\u3044\u3066\u306e\u89e3\u8aac\u8a18\u4e8b\u3092\u3068\u304d\u3069\u304d\u6295\u7a3f GitHub \u3086\u3093 (@yun-cpp-v) C++\u30e9\u30a4\u30d6\u30e9\u30ea\u3084\u63d0\u6848\u6587\u66f8\u306e\u65e5\u672c\u8a9e\u8a33\u306a\u3069\u3092\u5236\u4f5c\u4e2d \u30de\u30b7\u30e5\u30de\u30ed \u3086\u3093 \u3075\u3064\u3046\u306b\u8cea\u554f\u3068\u304b\u3092\u52df\u96c6\u4e2d <ol> <li> <p>\u5e83\u7fa9\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u597d\u304d\u306a\u4eba\u3092\u6307\u3059\u547c\u79f0 \u21a9</p> </li> </ol>"},{"location":"posts/","title":"\u8a18\u4e8b\u4e00\u89a7","text":""},{"location":"posts/#2026","title":"2026\u5e74","text":""},{"location":"posts/#9","title":"9\u6708","text":"<ul> <li>2026/09/22: \u306f\u308d\u30fc\u308f\u30fc\u308b\u3069</li> <li>2026/09/23: \u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u793e\u4f1a\u5951\u7d04</li> </ul>"},{"location":"posts/2026/09/hello-world/","title":"\u306f\u308d\u30fc\u308f\u30fc\u308b\u3069","text":"<pre><code>Hello, Blogging World!\n</code></pre> <p>\u2191\u3053\u306e\u985e\u306e\u4f55\u304b\u3092\u59cb\u3081\u308b\u3068\u304d\u306e\u5100\u5f0f\uff0e</p> <p>\u2026\u3055\u3066\uff0c\u3086\u3093\u306e\u30d6\u30ed\u30b0\u306e\u6700\u521d\u306e\u8a18\u4e8b\u306a\u306e\u3067\uff0c\u3053\u306e\u30d6\u30ed\u30b0\u306e\u65b9\u91dd\u3067\u3082\u8a71\u305d\u3046\u304b\u306a\uff0e</p> <p>\u7aef\u7684\u306b\u8a00\u3046\u3068\uff0c\u3053\u3053\u306b\u306f\u79c1\u304c\u4ed6\u30b5\u30a4\u30c8\u306b\u306f\u7f6e\u3051\u306a\u3044\u4f55\u304b\u3092\u8f09\u305b\u3066\u3044\u304f\u3064\u3082\u308a\u3060\u3088\uff0e \u3064\u307e\u308a\uff0cTwitter\u306b\u66f8\u304f\u306b\u306f\u9577\u3059\u304e\u3066\uff0c\u3057\u304b\u3057Qiita\u306b\u63b2\u8f09\u3059\u308b\u306e\u306f\u9055\u3046\u3057\uff0c\u3067\u3082\u30cb\u30b3\u30cb\u30b3\u306b\u6295\u7a3f\u3059\u308b\u305f\u3081\u306e\u52d5\u753b\u5316\u306e\u30b3\u30b9\u30c8\u3092\u6255\u3046\u307b\u3069\u3067\u3082\u306a\u3044\uff0c\u305d\u3046\u3044\u3046\u601d\u3044\u4ed8\u304d\u3092\u8f09\u305b\u3066\u3044\u304f\u3088\uff0e \u306f\u3066\u306a\u30d6\u30ed\u30b0\u304b\u4f55\u304b\u3092\u4f7f\u3063\u3066\uff0cQiita\u3068\u4e00\u7dd2\u306b\u3059\u308c\u3070\u3088\u304b\u3063\u305f\u6c17\u3082\u3059\u308b\u3051\u3069\uff0e</p> <p>\u3053\u308c\u307e\u3067\u305d\u3046\u3044\u3046\u601d\u3044\u4ed8\u304d\u306e\u8a71\u306fDiscord\u306e\u8eab\u5185\u30b5\u30fc\u30d0\u30fc\u306e\u81ea\u5206\u7528\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u3057\u3066\u305f\u3093\u3060\u3051\u3069 \u306a\u3093\u3068\u306a\u304f\u4eba\u304c\u898b\u3089\u308c\u308b\u3088\u3046\u306b\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u306d\uff0e \u305d\u308c\u306b\u3061\u3083\u3093\u3068\u30bf\u30a4\u30c8\u30eb\u3092\u3064\u3051\u3066\u6574\u7406\u3059\u308c\u3070\u5f8c\u304b\u3089\u898b\u8fd4\u3057\u3084\u3059\u3044\u3057\uff0e \u3060\u304b\u3089\u305f\u3076\u3093\uff0c\u3053\u308c\u304b\u3089\u3057\u3070\u3089\u304f\u306f\u305d\u306eDiscord\u3092\u767a\u6398\u3057\u3066\u307e\u3068\u3081\u305f\u3082\u306e\u3092\u66f8\u304f\u304b\u306a\uff1f</p> <p>\u3053\u3053\u307e\u3067\u306e\u611f\u3058\u3067\u308f\u304b\u308b\u304b\u3082\u3060\u3051\u3069\uff0c\u3053\u3053\u306b\u306f\u3053\u3093\u306a\u611f\u3058\u3067\u4eba\u304c\u8aad\u3080\u3053\u3068\u3092\u8003\u3048\u3066\u306a\u3044\u3088\u3046\u306a\u6587\u7ae0\u3092\u66f8\u304f\u3088\uff0e\u6587\u7ae0\u3092\u66f8\u3044\u3066\u516c\u958b\u3059\u308b\u3068\u3044\u3046\u3088\u308a\uff0c\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u901a\u3057\u305f\u3072\u3068\u308a\u3054\u3068\u3063\u3066\u611f\u3058\uff0e</p> <p>\u305f\u3060\u3044\u307e\u306e\u6642\u523b\u306f5\u664230\u5206\uff0e\u5bdd\u307e\u3059\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/","title":"\u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u793e\u4f1a\u5951\u7d04","text":"<p>\u6ce8: \u3053\u306e\u8a18\u4e8b\u306f\u653f\u6cbb\u54f2\u5b66\u306e\u30c9\u7d20\u4eba\u306b\u3088\u308b\u601d\u3044\u3064\u304d\u3067\u3059\uff0e\u305f\u3076\u3093\u3081\u3061\u3083\u304f\u3061\u3083\u306a\u3053\u3068\u3092\u8a00\u3063\u3066\u3044\u307e\u3059\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#tldr","title":"TL;DR","text":"<p>Q.</p> <p>\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u3068\uff0c\u81ea\u7136\u6a29\u304c\u76f8\u5bfe\u5316\u3055\u308c\uff0c\u793e\u4f1a\u5951\u7d04\u8aac\u306e\u6b63\u5f53\u6027\u304c\u63fa\u3089\u3050\u306e\u3067\u306f\uff1f</p> <p>A.</p> <p>\u81ea\u7136\u6a29\u306e\u5e30\u5c5e\u3092\u4efb\u610f\u306e\u5bfe\u8c61\u3078\u4e00\u822c\u5316\u3059\u308b\u516c\u7406\u3092\u7f6e\u3051\u3070\uff0c\u81ea\u7136\u6a29\u306f\u793e\u4f1a\u306b\u3088\u3063\u3066\u9078\u5225\u3055\u308c\u306a\u3044\uff0e \u307e\u305f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3068\u3057\u3066\u6271\u3046\u3053\u3068\u3067\uff0c\u4eba\u9593\u3068\u540c\u3058\u304f\u793e\u4f1a\u5951\u7d04\u8aac\u306e\u67a0\u7d44\u307f\u3078\u7d44\u307f\u8fbc\u3081\u308b\uff0e</p> <p>\u3053\u3046\u8003\u3048\u308b\u3053\u3068\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4fdd\u969c\u3059\u308b\u3053\u3068\u3068\uff0c\u81ea\u7136\u6a29\u8ad6\u3068\u793e\u4f1a\u5951\u7d04\u8aac\u3092\u4e21\u7acb\u3059\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3042\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_2","title":"\u6982\u8981","text":"<p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u308b\u3053\u3068\u304c\uff0c\u793e\u4f1a\u5951\u7d04\u3084\u81ea\u7136\u6a29\u306e\u8003\u3048\u65b9\u3068\u3069\u306e\u3088\u3046\u306b\u95a2\u4fc2\u3059\u308b\u306e\u304b\u3092\u691c\u8a0e\u3059\u308b\uff0e\u6a29\u5229\u306e\u6709\u7121\u3068\u884c\u4f7f\u80fd\u529b\uff0c\u793e\u4f1a\u7684\u306a\u4fdd\u969c\u306e\u6982\u5ff5\u3092\u533a\u5225\u3057\u305f\u3046\u3048\u3067\uff0c\u300c\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u3053\u3068\u306e\u610f\u5473\u3092\u6574\u7406\u3057\uff0c\u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\u306b\u3064\u3044\u3066\u8003\u5bdf\u3059\u308b\uff0e\u3055\u3089\u306b\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u306a\u308a\u5f97\u308b\u304b\u306b\u3064\u3044\u3066\u691c\u8a0e\u3059\u308b\u3053\u3068\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3078\u306e\u4eba\u6a29\u4fdd\u969c\u3092\u8a8d\u3081\u305f\u3068\u3057\u3066\u3082\uff0c\u81ea\u7136\u6a29\u8ad6\u3068\u793e\u4f1a\u5951\u7d04\u8ad6\u3092\u6574\u5408\u7684\u306b\u7dad\u6301\u3067\u304d\u308b\u7406\u8ad6\u30e2\u30c7\u30eb\u304c\u69cb\u6210\u53ef\u80fd\u3067\u3042\u308b\u3053\u3068\u3092\u793a\u3059\uff0e</p> <p>\u306a\u304a\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u3092\u5f93\u6765\u306e\u7406\u8ad6\u304b\u3089\u5c0e\u304f\u306e\u3067\u306f\u306a\u304f\uff0c\u5f93\u6765\u306e\u7406\u8ad6\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u306e\u6574\u5408\u6027\u306b\u3064\u3044\u3066\u8003\u5bdf\u3059\u308b\u3068\u3044\u3046\u3053\u3068\u306b\u6ce8\u610f\u3055\u308c\u305f\u3044\uff0e\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u308b\u3053\u3068\u81ea\u4f53\u306e\u662f\u975e\u306b\u3064\u3044\u3066\u306f\u8003\u5bdf\u3057\u306a\u3044\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_3","title":"\u524d\u63d0","text":"<p>\u3053\u306e\u8a18\u4e8b\u3067\u8003\u5bdf\u3059\u308b\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u300d\u3068\u306f\uff0c\u4eba\u9593\u3068\u540c\u7b49\u306e\u77e5\u7684\u80fd\u529b\u304a\u3088\u3073\u793e\u4f1a\u7684\u80fd\u529b\u3092\u6301\u3064\uff0c\u4eba\u9593\u306b\u3088\u308a\u5de5\u696d\u88fd\u54c1\u3068\u3057\u3066\u751f\u7523\u3055\u308c\u308b\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u3067\u3042\u308b\u3068\u3059\u308b\uff0e</p> <p>\u3053\u306e\u524d\u63d0\u306e\u4e0b\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u3068\u793e\u4f1a\u5951\u7d04\u306b\u3064\u3044\u3066\u8003\u3048\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_4","title":"\u3053\u306e\u8a18\u4e8b\u306e\u653f\u6cbb\u54f2\u5b66\u4e0a\u306e\u7acb\u5834","text":"<p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u6a29\u5229\u306e\u6839\u62e0\u3068\u3057\u3066\u81ea\u7136\u6a29\u8ad6\u306e\u7acb\u5834\u3092\u63a1\u7528\u3059\u308b\uff0e\u3059\u306a\u308f\u3061\uff0c\u6a29\u5229\u306f\u56fd\u5bb6\u3084\u653f\u6cbb\u793e\u4f1a\u306b\u3088\u308b\u627f\u8a8d\u306b\u3088\u3063\u3066\u521d\u3081\u3066\u6210\u7acb\u3059\u308b\u306e\u3067\u306f\u306a\u304f\uff0c\u653f\u6cbb\u793e\u4f1a\u306b\u3088\u308b\u627f\u8a8d\u3068\u306f\u72ec\u7acb\u3057\u3066\u4e3b\u4f53\u306b\u5e30\u5c5e\u3059\u308b\u3082\u306e\u3068\u8003\u3048\u308b\uff0e\u307e\u305f\uff0c\u4eba\u6a29\u3092\u6cd5\u7684\u306a\u6a29\u5229\u3068\u3057\u3066\u3067\u306f\u306a\u304f\uff0c\u81ea\u7136\u6a29\u3068\u3057\u3066\u6349\u3048\u308b\uff0e\u5f8c\u3067\u8ff0\u3079\u308b\u3053\u3068\u306b\u306a\u308b\u304c\uff0c\u3053\u306e\u8a18\u4e8b\u3067\u306f\u300c\u4eba\u6a29\u300d\u3092\u300c\u4eba\u9593\u306e\u6a29\u5229\u300d\u3068\u3044\u3046\u610f\u5473\u3067\u306f\u6271\u308f\u306a\u3044\uff0e</p> <p>\u793e\u4f1a\u5951\u7d04\u306b\u3064\u3044\u3066\u306f\uff0c\u3053\u308c\u3092\u653f\u6cbb\u793e\u4f1a\u3092\u5f62\u6210\u3059\u308b\u4e3b\u4f53\u306e\u9593\u306e\u5408\u610f\u3068\u3057\u3066\u6349\u3048\u308b\uff0e\u306a\u304a\uff0c\u3053\u3053\u3067\u3044\u3046\u4e3b\u4f53\u3068\u306f\uff0c\u5c11\u306a\u304f\u3068\u3082\uff0c\u5951\u7d04\u306e\u5185\u5bb9\u3092\u7406\u89e3\u3057\uff0c\u81ea\u3089\u306e\u610f\u601d\u306b\u3088\u3063\u3066\u4ed6\u8005\u3068\u306e\u95a2\u4fc2\u3092\u69cb\u7bc9\u3059\u308b\u80fd\u529b\u3092\u6301\u3064\u5b58\u5728\u3092\u6307\u3059\uff0e</p> <p>\u672c\u8a18\u4e8b\u3067\u306f\uff0c\u30ed\u30c3\u30af\u306e\u81ea\u7136\u6a29\u8ad6\u304a\u3088\u3073\u793e\u4f1a\u5951\u7d04\u8ad6\u306b\u898b\u3089\u308c\u308b\u69cb\u9020\u3092\u53c2\u8003\u306b\u3057\u3064\u3064\uff0c\u305d\u308c\u3092\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u62e1\u5f35\u3057\u305f\u72ec\u81ea\u306e\u30e2\u30c7\u30eb\u3092\u8003\u3048\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_5","title":"\u304d\u3063\u304b\u3051\u3068\u306a\u3063\u305f\u30c4\u30a4\u30fc\u30c8\u306e\u4e3b\u5f35\u306e\u6574\u7406","text":"<p>\u3053\u306e\u8a18\u4e8b\u306e\u57f7\u7b46\u306e\u304d\u3063\u304b\u3051\u3068\u306a\u3063\u305f\uff0c\u30ab\u30cb\u306b\u306a\u308a\u305f\u304b\u3063\u305f\u30ab\u30cb\u30ab\u30de\u6c0f\u306b\u3088\u308b\u30c4\u30a4\u30fc\u30c8\u3092\u53d6\u308a\u4e0a\u3052\u308b\uff0e</p> <p>         \u30dc\u30a4\u30ed\u306b\u4eba\u6a29\u3092\u4ed8\u4e0e\u3059\u308b\u8a71\u3001\u4eba\u9593\u306e\u4eba\u6a29\u304c\u76f8\u5bfe\u5316\u3055\u308c\u308b\u5371\u3055\u304c\u9593\u9055\u3044\u306a\u304f\u3042\u308b         \u3064\u307e\u308a\u4eba\u5de5\u7269\u3078\u6063\u610f\u7684\u306b\u4eba\u6a29\u3092\u4ed8\u4e0e\u30fb\u7c12\u596a\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u3068\u3001\u3053\u308c\u307e\u3067\u81ea\u660e\u306e\u3082\u306e\u3068\u3057\u3066\u3044\u305f\u81ea\u7136\u6a29\u3084\u305d\u308c\u306b\u57fa\u3065\u304f\u793e\u4f1a\u5951\u7d04\u7684\u306a\u69cb\u9020\u306e\u6b63\u5f53\u6027\u304c\u5d29\u58ca\u3057\u3066\u3057\u307e\u3046         \u5f93\u3063\u3066\u79c1\u306f\u30dc\u30a4\u30ed\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u3079\u304d\u3067\u306f\u306a\u3044\u3068\u601d\u3044\u307e\u3059(\uff78\uff9e\uff8d\uff8d     </p>     \u2014 \u30ab\u30cb\u306b\u306a\u308a\u305f\u304b\u3063\u305f\u30ab\u30cb\u30ab\u30de (@_crab_stick_) September 8, 2026 <p>\u307e\u305a\u306f\u8003\u5bdf\u3092\u59cb\u3081\u308b\u524d\u306b\uff0c\u3053\u306e\u30c4\u30a4\u30fc\u30c8\u306e\u4e3b\u5f35\u3092\u6b21\u306e\u3088\u3046\u306b\u6574\u7406\u3059\u308b\uff0e</p> <p>\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u884c\u70ba\u3092\u8a8d\u3081\u308b\u3053\u3068\u306f\uff0c\u3042\u308b\u5b58\u5728\u304c\u4eba\u6a29\u3092\u6709\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u793e\u4f1a\u7684\u306a\u5224\u65ad\u306b\u3088\u308a\u6c7a\u5b9a\u3067\u304d\u308b\u3068\u8a8d\u3081\u308b\u3053\u3068\u306b\u3064\u306a\u304c\u308b\uff0e</p> <p>\u3082\u3057\uff0c\u3042\u308b\u5b58\u5728\u304c\u4eba\u6a29\u3092\u6301\u3064\u304b\u3069\u3046\u304b\u3092\u793e\u4f1a\u7684\u306a\u5224\u65ad\u306b\u3088\u308a\u6c7a\u5b9a\u3067\u304d\u308b\u3068\u3044\u3046\u3053\u3068\u3092\u8a8d\u3081\u308b\u306e\u3067\u3042\u308c\u3070\uff0c\u305d\u306e\u8ad6\u7406\u306f\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u9650\u3089\u305a\u4eba\u9593\u81ea\u8eab\u306b\u3082\u9069\u7528\u3067\u304d\u308b\u306f\u305a\u3067\u3042\u308b\uff0e\u305d\u306e\u3068\u304d\uff0c\u4eba\u9593\u81ea\u8eab\u304c\u4eba\u6a29\u3092\u6709\u3059\u308b\u3053\u3068\u3082\u307e\u305f\uff0c\u4f55\u8005\u304b\u306b\u3088\u308a\u6c7a\u5b9a\u3055\u308c\u305f\u7d50\u679c\u306b\u3059\u304e\u306a\u3044\u3068\u7591\u3046\u3053\u3068\u304c\u3067\u304d\u308b\uff0e</p> <p>\u3057\u304b\u3057\u3053\u308c\u306f\uff0c\u4eba\u6a29\u306f\u56fd\u5bb6\u3084\u793e\u4f1a\u306b\u3088\u3063\u3066\u4e0e\u3048\u3089\u308c\u308b\u3082\u306e\u3067\u306f\u306a\u304f\uff0c\u4eba\u9593\u304c\u751f\u6765\u6709\u3057\u3066\u3044\u308b\u81ea\u7136\u6a29\u3067\u3042\u308b\uff0c\u3068\u3044\u3046\u4f1d\u7d71\u7684\u306a\u69cb\u9020\u3068\u5bfe\u7acb\u3059\u308b\uff0e\u81ea\u7136\u6a29\u3068\u3057\u3066\u306e\u4eba\u6a29\u306f\uff0c\u793e\u4f1a\u306b\u3088\u308b\u5224\u65ad\u306b\u95a2\u4fc2\u306a\u304f\u5b58\u5728\u3059\u308b\u304b\u3089\u3067\u3042\u308b\uff0e</p> <p>\u307e\u305f\u3053\u306e\u554f\u984c\u306f\uff0c\u81ea\u7136\u6a29\u3092\u6709\u3059\u308b\u5e73\u7b49\u3067\u81ea\u7531\u306a\u500b\u4eba\u304c\u5951\u7d04\u306b\u3088\u3063\u3066\u653f\u6cbb\u793e\u4f1a\u3092\u5f62\u6210\u3057\u305f\u3068\u3059\u308b\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u3082\u6ce2\u53ca\u3059\u308b\uff0e\u3082\u3057\u4eba\u6a29\u305d\u306e\u3082\u306e\u304c\u793e\u4f1a\u7684\u306a\u5224\u65ad\u306b\u3088\u308a\u6210\u7acb\u3059\u308b\u306e\u3067\u3042\u308c\u3070\uff0c\u305d\u306e\u3088\u3046\u306b\u81ea\u7136\u6a29\u3092\u524d\u63d0\u3068\u3059\u308b\u793e\u4f1a\u5951\u7d04\u8aac\u306e\u524d\u63d0\u305d\u306e\u3082\u306e\u3092\u518d\u691c\u8a0e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3089\u3060\uff0e</p> <p>\u4ee5\u4e0a\u304c\uff0c\u3053\u306e\u8a18\u4e8b\u3067\u8003\u5bdf\u3059\u308b\u554f\u984c\u306e\u69cb\u56f3\u3067\u3042\u308b\uff0e</p> <p>\u306a\u304a\uff0c\u3053\u306e\u8a18\u4e8b\u306e\u76ee\u7684\u306f\uff0c\u3053\u306e\u30c4\u30a4\u30fc\u30c8\u306e\u554f\u984c\u63d0\u8d77\u304c\u8aa4\u3063\u3066\u3044\u308b\u3068\u4e3b\u5f35\u3059\u308b\u3053\u3068\u3067\u306f\u306a\u3044\uff0e\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3078\u306e\u4eba\u6a29\u4fdd\u969c\u3092\u8a8d\u3081\u305f\u3068\u3057\u3066\u3082\uff0c\u81ea\u7136\u6a29\u8ad6\u3084\u793e\u4f1a\u5951\u7d04\u8aac\u304c\u76f8\u5bfe\u5316\u3055\u308c\u308b\u3053\u3068\u306e\u306a\u3044\u7406\u8ad6\u7684\u306a\u30e2\u30c7\u30eb\u304c\u69cb\u6210\u53ef\u80fd\u3060\u3068\u793a\u3059\u3053\u3068\u3067\u3042\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_6","title":"\u554f\u984c\u306e\u89e3\u91c8\u3068\u691c\u8a0e","text":"<p>\u3067\u306f\uff0c\u3053\u306e\u554f\u984c\u3092\u691c\u8a0e\u3059\u308b\u306b\u3042\u305f\u3063\u3066\uff0c\u307e\u305a\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u884c\u70ba\u304c\u4f55\u3092\u610f\u5473\u3059\u308b\u306e\u304b\u3092\u8003\u3048\u308b\uff0e</p> <p>\u3053\u3053\u3067\u300c\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u884c\u70ba\u304c\uff0c\u672c\u5f53\u306b\u4eba\u6a29\u305d\u306e\u3082\u306e\u3092\u767a\u751f\u3055\u305b\u308b\u884c\u70ba\u306a\u306e\u304b\uff0c\u3068\u3044\u3046\u3053\u3068\u3092\u554f\u984c\u3068\u3059\u308b\uff0e</p> <p>\u305f\u3057\u304b\u306b\u793e\u4f1a\u306f\u3042\u308b\u5b58\u5728\u3092\u6a29\u5229\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u304b\u3069\u3046\u304b\u3092\u6c7a\u5b9a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\uff0e\u305d\u3057\u3066\u305d\u306e\u6c7a\u5b9a\u306b\u3088\u308a\uff0c\u305d\u306e\u5b58\u5728\u304c\u793e\u4f1a\u306e\u4e2d\u3067\u3069\u306e\u3088\u3046\u306a\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\uff0c\u307e\u305f\u3069\u306e\u3088\u3046\u306a\u6a29\u5229\u304c\u4fdd\u969c\u3055\u308c\u308b\u306e\u304b\u3092\u6c7a\u5b9a\u3067\u304d\u308b\u3060\u308d\u3046\uff0e \u3057\u304b\u3057\uff0c\u3053\u3053\u3067\u6c7a\u5b9a\u3055\u308c\u3066\u3044\u308b\u306e\u306f\uff0c\u305d\u306e\u5b58\u5728\u304c\u6a29\u5229\u3092\u6709\u3059\u308b\u304b\u3069\u3046\u304b\u3067\u306f\u306a\u304f\uff0c\u793e\u4f1a\u304c\u305d\u306e\u5b58\u5728\u306e\u6a29\u5229\u3092\u3069\u306e\u3088\u3046\u306b\u6271\u3046\u304b\u3067\u306f\u306a\u3044\u3060\u308d\u3046\u304b\uff0e</p> <p>\u3082\u3057\u305d\u3046\u306a\u3089\u3070\uff0c\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u884c\u70ba\u306f\u300c\u4eba\u9593\u304c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u3092\u767a\u751f\u3055\u305b\u308b\u300d\u306e\u3067\u306f\u306a\u304f\u300c\u4eba\u9593\u304c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u3092\u81ea\u3089\u306e\u793e\u4f1a\u306b\u304a\u3044\u3066\u4fdd\u969c\u3059\u308b\u300d\u3068\u89e3\u91c8\u3067\u304d\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_7","title":"\u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\u3068\u884c\u4f7f\u80fd\u529b","text":"<p>\u307e\u305a\uff0c\u3042\u308b\u5b58\u5728\u304c\u6a29\u5229\u3092\u6709\u3057\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u3068\uff0c\u305d\u306e\u5b58\u5728\u304c\u5b9f\u969b\u306b\u305d\u306e\u6a29\u5229\u3092\u884c\u4f7f\u3059\u308b\u80fd\u529b\u3092\u6301\u3064\u3053\u3068\u306f\uff0c\u533a\u5225\u3055\u308c\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\uff0e\u6a29\u5229\u3092\u6709\u3059\u308b\u3053\u3068\u306f\uff0c\u305d\u306e\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u306a\u3044\uff0e\u3053\u306e\u3053\u3068\u306f\uff0c\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\u306a\u3044\u7406\u7531\u304c\uff0c\u7269\u7406\u7684\u306a\u3082\u306e\u3067\u3042\u308b\u304b\uff0c\u6cd5\u7684\u306a\u3082\u306e\u3067\u3042\u308b\u304b\uff0c\u3042\u308b\u3044\u306f\u305d\u308c\u4ee5\u5916\u306e\u4f55\u3067\u3042\u3063\u3066\u3082\u5909\u308f\u308b\u3082\u306e\u3067\u306f\u306a\u3044\uff0e</p> <p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u6a29\u5229\u306e\u5e30\u5c5e\u305d\u306e\u3082\u306e\u306b\u3064\u3044\u3066\uff0c\u5bfe\u8c61\u304c\u4eba\u9593\u3067\u3042\u308b\u304b\uff0c\u4eba\u683c\u3092\u6301\u3064\u304b\uff0c\u3042\u308b\u3044\u306f\u6a29\u5229\u3092\u884c\u4f7f\u3059\u308b\u80fd\u529b\u3092\u6301\u3064\u304b\u306b\u3088\u3063\u3066\u5236\u9650\u3055\u308c\u306a\u3044\u3068\u8003\u3048\u308b\uff0e\u3059\u306a\u308f\u3061\uff0c\u81ea\u7136\u6a29\u3068\u3057\u3066\u306e\u6a29\u5229\u3092\u4efb\u610f\u306e\u5bfe\u8c61\u307e\u3067\u4e00\u822c\u5316\u3057\uff0c\u4efb\u610f\u306e\u5bfe\u8c61\u304c\u305d\u306e\u610f\u5473\u3067\u306e\u6a29\u5229\u3092\u6709\u3059\u308b\u3068\u3044\u3046\u539f\u7406\u3092\u5c0e\u5165\u3059\u308b\uff0e</p> <p>\u3053\u3053\u3067\u3044\u3046\u300c\u6a29\u5229\u3092\u6709\u3059\u308b\u300d\u3068\u306f\uff0c\u305d\u306e\u5bfe\u8c61\u306b\u3064\u3044\u3066\u5177\u4f53\u7684\u306b\u3069\u306e\u3088\u3046\u306a\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\u308b\u304b\u304c\u5224\u660e\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u306a\u3044\uff0e\u6a29\u5229\u306e\u5e30\u5c5e\u3068\uff0c\u305d\u306e\u6a29\u5229\u306e\u3046\u3061\u5b9f\u969b\u306b\u4f55\u304c\u884c\u4f7f\u3067\u304d\u308b\u304b\u306f\uff0c\u5225\u306e\u554f\u984c\u3067\u3042\u308b\uff0e\u3042\u308b\u5bfe\u8c61\u304c\u6a29\u5229\u3092\u6709\u3057\u3066\u3044\u3066\u3082\uff0c\u73fe\u5b9f\u306b\u884c\u4f7f\u53ef\u80fd\u306a\u6a29\u5229\u304c\u5b58\u5728\u3057\u306a\u3044\u3053\u3068\u306f\u3042\u308a\u3046\u308b\uff0e</p> <p>\u3053\u306e\u539f\u7406\u3092\u8aac\u660e\u3059\u308b\u305f\u3081\u306b\uff0c\u6975\u7aef\u306a\u5bfe\u8c61\u306b\u3064\u3044\u3066\u8003\u3048\u308b\uff0e \u305f\u3068\u3048\u3070\uff0c\u9053\u7aef\u306e\u77f3\u3053\u308d\u306b\u3064\u3044\u3066\u3082\uff0c\u3053\u306e\u539f\u7406\u306b\u3088\u308c\u3070\uff0c\u6a29\u5229\u306e\u5e30\u5c5e\u306f\u5426\u5b9a\u3055\u308c\u306a\u3044\uff0e\u3057\u304b\u3057\uff0c\u3053\u306e\u3053\u3068\u306f\u77f3\u3053\u308d\u304c\u4f55\u3089\u304b\u306e\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u306a\u3044\uff0e\u300c\u6a29\u5229\u3092\u6709\u3059\u308b\u300d\u3053\u3068\u3068\u300c\u6a29\u5229\u3092\u884c\u4f7f\u3067\u304d\u308b\u300d\u3053\u3068\u306f\uff0c\u540c\u3058\u610f\u5473\u3067\u306f\u306a\u3044\u306e\u3060\uff0e\u3053\u308c\u307e\u3067\u77f3\u3053\u308d\u3092\u300c\u6a29\u5229\u3092\u6301\u305f\u306a\u3044\u5bfe\u8c61\u300d\u3068\u8003\u3048\u3066\u3044\u305f\u306a\u3089\u3070\uff0c\u3053\u306e\u8a18\u4e8b\u306f\u305d\u308c\u3092\u300c\u81ea\u7136\u6a29\u7684\u306a\u6a29\u5229\u306f\u6709\u3059\u308b\u304c\uff0c\u305d\u308c\u3092\u884c\u4f7f\u3059\u308b\u80fd\u529b\u3092\u6301\u305f\u306a\u3044\u5bfe\u8c61\u300d\u3068\u6349\u3048\u308b\uff0e</p> <p>\u3053\u306e\u3068\u304d\uff0c\u77f3\u3053\u308d\u306b\u3064\u3044\u3066\u3069\u306e\u3088\u3046\u306a\u6a29\u5229\u304c\u5b58\u5728\u3059\u308b\u306e\u304b\u3092\u5177\u4f53\u7684\u306b\u5217\u6319\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\uff0e\u6975\u7aef\u306b\u3044\u3048\u3070\uff0c\u81ea\u7136\u6a29\u3068\u3057\u3066\u5e30\u5c5e\u3059\u308b\u6a29\u5229\u306e\u96c6\u5408\u3092\uff0c\u6982\u5ff5\u7684\u306b\u3059\u3079\u3066\u306e\u6a29\u5229\u3068\u3057\u3066\u8003\u3048\u3066\u3082\u3088\u3044\uff0e\u305d\u306e\u3046\u3061\u73fe\u5b9f\u306b\u884c\u4f7f\u3067\u304d\u308b\u3082\u306e\u304c\u4f55\u3067\u3042\u308b\u304b\u306f\uff0c\u5bfe\u8c61\u306e\u6027\u8cea\u3084\u7f6e\u304b\u308c\u305f\u72b6\u6cc1\u306b\u3088\u3063\u3066\u5225\u9014\u5b9a\u307e\u308b\u304b\u3089\u3067\u3042\u308b\uff0e\u3057\u305f\u304c\u3063\u3066\uff0c\u81ea\u7136\u6a29\u306e\u5185\u5bb9\u3092\u5177\u4f53\u7684\u306b\u78ba\u5b9a\u3059\u308b\u3053\u3068\u306f\uff0c\u3053\u306e\u8a18\u4e8b\u306e\u8b70\u8ad6\u306b\u304a\u3044\u3066\u672c\u8cea\u7684\u3067\u306f\u306a\u3044\uff0e\u91cd\u8981\u306a\u306e\u306f\uff0c\u3042\u308b\u6a29\u5229\u304c\u81ea\u7136\u6a29\u3068\u3057\u3066\u5e30\u5c5e\u3059\u308b\u3053\u3068\u3068\uff0c\u305d\u306e\u6a29\u5229\u304c\u5b9f\u969b\u306b\u884c\u4f7f\u53ef\u80fd\u3067\u3042\u308b\u3053\u3068\u3092\u533a\u5225\u3059\u308b\u3053\u3068\u3067\u3042\u308b\uff0e</p> <p>\u3053\u3053\u3067\uff0c\u81ea\u7136\u6a29\u7684\u306a\u6a29\u5229\u306b\u3064\u3044\u3066\u300c\u6301\u3064\u304b\u3069\u3046\u304b\u3092\u8003\u3048\u308b\u5fc5\u8981\u304c\u306a\u3044\u300d\u3068\u4e3b\u5f35\u305b\u305a\u306b\u300c\u4efb\u610f\u306e\u5bfe\u8c61\u304c\u6301\u3064\u300d\u3068\u3044\u3046\u5f37\u3044\u539f\u7406\u3092\u5c0e\u5165\u3059\u308b\u306e\u306f\uff0c\u305d\u308c\u304c\u76f8\u5bfe\u5316\u3055\u308c\u308b\u53ef\u80fd\u6027\u3092\u6392\u9664\u3059\u308b\u305f\u3081\u3067\u3042\u308b\uff0e\u3042\u308b\u5bfe\u8c61\u304c\u81ea\u7136\u6a29\u3092\u6301\u305f\u306a\u3044\u53ef\u80fd\u6027\u3092\u8a8d\u3081\u308b\u306a\u3089\u3070\uff0c\u3069\u306e\u5bfe\u8c61\u304c\u6a29\u5229\u3092\u6301\u3064\u306e\u304b\u3092\u533a\u5225\u3059\u308b\u305f\u3081\u306e\u6761\u4ef6\u304c\u5fc5\u8981\u306b\u306a\u308b\uff0e\u305d\u306e\u6761\u4ef6\u304c\u4f55\u3067\u3042\u308b\u304b\u3092\u554f\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u4ee5\u4e0a\uff0c\u3055\u3089\u306b\u305d\u306e\u6761\u4ef6\u3092\u4f55\u304c\u5224\u65ad\u3059\u308b\u306e\u304b\uff0c\u4f55\u306b\u3088\u3063\u3066\u6c7a\u5b9a\u3059\u308b\u306e\u304b\u3068\u3044\u3046\u554f\u984c\u304c\u751f\u3058\u308b\uff0e</p> <p>\u3053\u306e\u610f\u5473\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u683c\u6027\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u4eba\u6a29\u3092\u6301\u3064\u3053\u3068\u306e\u6839\u62e0\u3067\u306f\u306a\u304f\uff0c\u305d\u308c\u306b\u3064\u3044\u3066\u8003\u5bdf\u3059\u308b\u3053\u3068\u306e\u5951\u6a5f\u306b\u3059\u304e\u306a\u3044\uff0e\u77f3\u3053\u308d\u306b\u3064\u3044\u3066\u3082\u540c\u69d8\u306b\u4eba\u6a29\u3092\u8003\u5bdf\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3060\u304c\uff0c\u73fe\u5b9f\u306e\u793e\u4f1a\u306b\u304a\u3044\u3066\u305d\u308c\u3092\u554f\u984c\u3068\u3059\u308b\u5951\u6a5f\u306f\u751f\u3058\u306b\u304f\u3044\uff0e</p> <p>\u3057\u305f\u304c\u3063\u3066\uff0c\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3082\u307e\u305f\u81ea\u7136\u6a29\u3068\u3057\u3066\u306e\u4eba\u6a29\u3092\u6709\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u524d\u63d0\u3068\u3059\u308b\uff0e\u306a\u304a\uff0c\u3053\u308c\u306f\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3060\u304b\u3089\u4eba\u6a29\u3092\u6709\u3057\u3066\u3044\u308b\u300d\u3068\u3057\u305f\u306e\u3067\u306f\u306a\u3044\u3053\u3068\u306b\u7559\u610f\u3057\u3066\u307b\u3057\u3044\uff0e\u4efb\u610f\u306e\u5bfe\u8c61\u304c\u3053\u306e\u610f\u5473\u3067\u306e\u4eba\u6a29\u3092\u6709\u3057\u3066\u3044\u308b\u3068\u3057\u305f\u3046\u3048\u3067\uff0c\u7279\u306b\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3068\u3044\u3046\u5bfe\u8c61\u306b\u3064\u3044\u3066\u8003\u5bdf\u3059\u308b\u306e\u3060\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_8","title":"\u6a29\u5229\u306e\u5b58\u5728\u3068\u793e\u4f1a\u7684\u4fdd\u969c","text":"<p>\u3053\u3053\u307e\u3067\u306e\u8b70\u8ad6\u3067\u306f\uff0c\u6a29\u5229\u306e\u6709\u7121\u3068\u3044\u3046\u554f\u984c\u3068\uff0c\u6a29\u5229\u3092\u884c\u4f7f\u3059\u308b\u80fd\u529b\u306e\u6709\u7121\u3068\u3044\u3046\u554f\u984c\u3092\u533a\u5225\u3057\u305f\uff0e\u305d\u3057\u3066\u4efb\u610f\u306e\u5bfe\u8c61\u304c\u81ea\u7136\u6a29\u7684\u306a\u4eba\u6a29\u3092\u6709\u3059\u308b\u3068\u4eee\u5b9a\u3059\u308b\u3053\u3068\u3067\uff0c\u3042\u308b\u5bfe\u8c61\u304c\u305d\u3082\u305d\u3082\u4eba\u6a29\u3092\u6709\u3059\u308b\u304b\u3068\u3044\u3046\u554f\u984c\u3092\u554f\u308f\u306a\u304f\u3066\u3088\u3044\u3053\u3068\u306b\u3057\u305f\uff0e\u4ee5\u4e0b\u3067\u306f\uff0c\u5b58\u5728\u3092\u4eee\u5b9a\u3055\u308c\u305f\u4eba\u6a29\u306b\u3064\u3044\u3066\uff0c\u305d\u306e\u653f\u6cbb\u793e\u4f1a\u3068\u306e\u95a2\u4fc2\u3092\u8003\u5bdf\u3059\u308b\uff0e</p> <p>\u307e\u305a\uff0c\u3042\u308b\u5b58\u5728\u304c\u6a29\u5229\u3092\u6709\u3057\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\uff0c\u305d\u306e\u6a29\u5229\u304c\u3042\u308b\u793e\u4f1a\u306b\u304a\u3044\u3066\u4fdd\u969c\u3055\u308c\u308b\u3053\u3068\u3092\u5c0e\u304b\u306a\u3044\uff0e\u307e\u305f\u9006\u306b\uff0c\u3042\u308b\u793e\u4f1a\u304c\u305d\u306e\u5b58\u5728\u306e\u6a29\u5229\u3092\u4fdd\u969c\u3057\u306a\u3044\u3068\u5224\u65ad\u3057\u305f\u3068\u3057\u3066\u3082\uff0c\u305d\u306e\u5224\u65ad\u306f\u6a29\u5229\u305d\u306e\u3082\u306e\u304c\u5b58\u5728\u3057\u306a\u3044\u3053\u3068\u3092\u610f\u5473\u3057\u306a\u3044\uff0e</p> <p>\u305d\u3046\u8003\u3048\u308b\u3068\u304d\uff0c\u793e\u4f1a\u304c\u6c7a\u5b9a\u3067\u304d\u308b\u306e\u306f\u6a29\u5229\u305d\u306e\u3082\u306e\u306e\u6709\u7121\u3067\u306f\u306a\u304f\uff0c\u81ea\u3089\u306e\u793e\u4f1a\u306b\u304a\u3044\u3066\u305d\u306e\u6a29\u5229\u3092\u4fdd\u969c\u3059\u308b\u304b\u3069\u3046\u304b\u3067\u3042\u308b\uff0e\u5c11\u306a\u304f\u3068\u3082\u3053\u3053\u3067\u554f\u984c\u3068\u3059\u308b\u610f\u5473\u3067\u306f\uff0c\u793e\u4f1a\u306f\u6a29\u5229\u305d\u306e\u3082\u306e\u306e\u6709\u7121\u3092\u6c7a\u5b9a\u3059\u308b\u3082\u306e\u3067\u306f\u306a\u3044\uff0e\u305d\u3057\u3066\uff0c\u305d\u306e\u554f\u984c\u306b\u3064\u3044\u3066\u306f\uff0c\u3059\u3067\u306b\u8ff0\u3079\u305f\u4eee\u5b9a\u306b\u3088\u3063\u3066\uff0c\u4ee5\u4e0b\u306e\u8b70\u8ad6\u3067\u306f\u554f\u984c\u3068\u3057\u306a\u3044\uff0e</p> <p>\u3053\u306e\u533a\u5225\u3092\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u9069\u7528\u3059\u308c\u3070\uff0c\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u4e0e\u3048\u308b\u300d\u3068\u3044\u3046\u3053\u3068\u306f\uff0c\u3053\u308c\u307e\u3067\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u5b58\u5728\u3057\u306a\u304b\u3063\u305f\u4eba\u6a29\u3092\u65b0\u305f\u306b\u767a\u751f\u3055\u305b\u308b\u3053\u3068\u3067\u306f\u306a\u304f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u6a29\u5229\u3092\u4eba\u9593\u793e\u4f1a\u306b\u304a\u3044\u3066\u4fdd\u969c\u3059\u308b\u3053\u3068\u3067\u3042\u308b\uff0e \u305d\u3057\u3066\u554f\u984c\u3068\u306a\u308b\u306e\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u6709\u3057\u3066\u3044\u308b\u6a29\u5229\u3068\u4eba\u9593\u306e\u653f\u6cbb\u793e\u4f1a\u306e\u95a2\u4fc2\u3067\u3042\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_9","title":"\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u306e\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9","text":"<p>\u3067\u306f\uff0c\u4eba\u9593\u793e\u4f1a\u304c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u6a29\u5229\u3092\u4fdd\u969c\u3059\u308b\u3068\u3044\u3046\u3053\u3068\u306f\uff0c\u5177\u4f53\u7684\u306b\u3069\u306e\u3088\u3046\u306a\u95a2\u4fc2\u3092\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3068\u306e\u9593\u306b\u69cb\u7bc9\u3059\u308b\u3053\u3068\u306a\u306e\u3060\u308d\u3046\u304b\uff0e</p> <p>\u4eba\u9593\u306e\u653f\u6cbb\u793e\u4f1a\u306b\u304a\u3044\u3066\uff0c\u3042\u308b\u5b58\u5728\u306e\u6a29\u5229\u3092\u4fdd\u969c\u3059\u308b\u3068\u3044\u3046\u3053\u3068\u306f\uff0c\u305d\u306e\u5b58\u5728\u3092\u5358\u306a\u308b\u4fdd\u8b77\u306e\u5bfe\u8c61\u3068\u3057\u3066\u6271\u3046\u3068\u3044\u3046\u3053\u3068\u3067\u306f\u306a\u304f\uff0c\u305d\u306e\u5b58\u5728\u3092\u6a29\u5229\u3068\u7fa9\u52d9\u3092\u62c5\u3046\u653f\u6cbb\u793e\u4f1a\u306b\u5c5e\u3059\u308b\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u3053\u3068\u3067\u3082\u3042\u308b\u3060\u308d\u3046\uff0e\u3053\u306e\u3088\u3046\u306a\u653f\u6cbb\u793e\u4f1a\u306e\u6210\u7acb\u6839\u62e0\u3092\u793e\u4f1a\u5951\u7d04\u306b\u3088\u308a\u8aac\u660e\u3059\u308b\u306a\u3089\u3070\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3069\u3046\u304b\u306b\u3064\u3044\u3066\u8003\u3048\u306a\u304f\u3066\u306f\u306a\u3089\u306a\u3044\uff0e</p> <p>\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u304a\u3044\u3066\uff0c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u304c\u8ab0\u3067\u3042\u308b\u304b\u306f\u975e\u81ea\u660e\u306a\u554f\u984c\u3060\uff0e\u308f\u308c\u308f\u308c\u304c\u77e5\u308b\u653f\u6cbb\u793e\u4f1a\u304c\u4eba\u9593\u306b\u3088\u3063\u3066\u69cb\u6210\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u306f\u4e8b\u5b9f\u3060\u304c\uff0c\u305d\u308c\u306f\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u304c\u4eba\u9593\u306b\u9650\u5b9a\u3055\u308c\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u306a\u3044\uff0e\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3092\u4eba\u9593\u306b\u9650\u5b9a\u3059\u308b\u306a\u3089\u3070\uff0c\u305d\u306e\u305f\u3081\u306e\u6839\u62e0\u304c\u5225\u306b\u5fc5\u8981\u3068\u306a\u308b\u3060\u308d\u3046\uff0e</p> <p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u793e\u4f1a\u5951\u7d04\u3092\uff0c\u653f\u6cbb\u793e\u4f1a\u3092\u5f62\u6210\u3059\u308b\u4e3b\u4f53\u306e\u9593\u306e\u5408\u610f\u3068\u3057\u3066\u6349\u3048\u308b\uff0e\u3053\u306e\u3068\u304d\uff0c\u305d\u308c\u3092\u884c\u3046\u4e3b\u4f53\u306b\u306f\uff0c\u5c11\u306a\u304f\u3068\u3082\u305d\u306e\u5951\u7d04\u3092\u7406\u89e3\u3057\uff0c\u81ea\u3089\u306e\u610f\u601d\u3067\u4ed6\u8005\u3068\u306e\u95a2\u4fc2\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u80fd\u529b\u304c\u5fc5\u8981\u306b\u306a\u308b\u3060\u308d\u3046\uff0e \u3053\u306e\u80fd\u529b\u3092\u6709\u3059\u308b\u3053\u3068\u3092\uff0c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u305f\u3081\u306e\u6761\u4ef6\u306e\u4e00\u3064\u3068\u3059\u308b\u304c\uff0c\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u3053\u308c\u304c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u306a\u308b\u305f\u3081\u306e\u5fc5\u8981\u5341\u5206\u6761\u4ef6\u3067\u3042\u308b\u3068\u306f\u4e3b\u5f35\u3057\u306a\u3044\uff0e</p> <p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u300c\u4eba\u9593\u3068\u540c\u7b49\u306e\u77e5\u7684\u80fd\u529b\u304a\u3088\u3073\u793e\u4f1a\u7684\u80fd\u529b\u3092\u6301\u3064\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u300d\u3060\u3068\u5b9a\u3081\u3066\u3044\u308b\uff0e\u3057\u305f\u304c\u3063\u3066\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306f\uff0c\u3053\u306e\u610f\u5473\u3067\u306e\u793e\u4f1a\u5951\u7d04\u3092\u7406\u89e3\u3057\uff0c\u81ea\u3089\u306e\u610f\u601d\u306b\u3088\u308a\u4ed6\u8005\u3068\u306e\u95a2\u4fc2\u3092\u69cb\u7bc9\u3067\u304d\u308b\u5b58\u5728\u3068\u3057\u3066\u8003\u3048\u3089\u308c\u308b\uff0e\u3053\u306e\u610f\u5473\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u305f\u3081\u306b\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u5bfe\u8c61\u3068\u3057\u305f\u7279\u5225\u306a\u6761\u4ef6\u3092\u8ffd\u52a0\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\uff0e</p> <p>\u3082\u3061\u308d\u3093\uff0c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3092\u4eba\u9593\u306b\u9650\u5b9a\u3059\u308b\u7acb\u5834\u3082\u8003\u3048\u3089\u308c\u308b\uff0e\u3057\u304b\u3057\uff0c\u305d\u306e\u5834\u5408\u306b\u306f\uff0c\u306a\u305c\u300c\u4eba\u9593\u3067\u3042\u308b\u3053\u3068\u300d\u304c\uff0c\u5951\u7d04\u3092\u7406\u89e3\u3057\u3066\u610f\u601d\u306b\u3088\u308a\u5408\u610f\u3092\u5f62\u6210\u3067\u304d\u308b\u3053\u3068\u3068\u306f\u5225\u306b\u5fc5\u8981\u306a\u306e\u304b\u3092\u8aac\u660e\u3057\u306a\u304f\u3066\u306f\u306a\u3089\u306a\u3044\uff0e\u5358\u306b\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306f\u4eba\u9593\u3067\u306f\u306a\u3044\u300d\u3068\u3044\u3046\u4e8b\u5b9f\u3060\u3051\u3067\u306f\uff0c\u672c\u8a18\u4e8b\u306e\u524d\u63d0\u306b\u304a\u3051\u308b\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u306e\u6761\u4ef6\u304b\u3089\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u6392\u9664\u3059\u308b\u7406\u7531\u306b\u306f\u306a\u3089\u306a\u3044\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_10","title":"\u4eba\u9593\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u793e\u4f1a\u5951\u7d04","text":"<p>\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u3068\u304d\uff0c\u305d\u306e\u793e\u4f1a\u5951\u7d04\u306b\u3088\u308a\u6210\u7acb\u3059\u308b\u653f\u6cbb\u793e\u4f1a\u306f\uff0c\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u306b\u306a\u308b\u306e\u3060\u308d\u3046\u304b\uff0e</p> <p>\u793e\u4f1a\u5951\u7d04\u3092\uff0c\u653f\u6cbb\u793e\u4f1a\u3092\u5f62\u6210\u3059\u308b\u4e3b\u4f53\u306e\u9593\u306e\u5408\u610f\u3060\u3068\u6349\u3048\u308b\u306a\u3089\u3070\uff0c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u306f\uff0c\u305d\u306e\u5951\u7d04\u306b\u3088\u308a\u6210\u7acb\u3059\u308b\u653f\u6cbb\u793e\u4f1a\u306e\u69cb\u6210\u54e1\u3060\u3068\u8003\u3048\u3089\u308c\u308b\uff0e \u3057\u305f\u304c\u3063\u3066\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u8a8d\u3081\u308b\u3053\u3068\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u653f\u6cbb\u793e\u4f1a\u306e\u69cb\u6210\u54e1\u3068\u3057\u3066\u8a8d\u3081\u308b\u3053\u3068\u3067\u3082\u3042\u308b\uff0e</p> <p>\u3053\u308c\u306f\uff0c\u4eba\u9593\u306b\u3088\u3063\u3066\u69cb\u6210\u3055\u308c\u308b\u793e\u4f1a\u306e\u4e2d\u306b\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u4fdd\u8b77\u306e\u5bfe\u8c61\u3068\u3057\u3066\u52a0\u3048\u308b\u3068\u3044\u3046\u610f\u5473\u3067\u306f\u306a\u3044\uff0e\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306f\u653f\u6cbb\u793e\u4f1a\u3092\u69cb\u6210\u3059\u308b\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3068\u3057\u3066\u4f4d\u7f6e\u3065\u3051\u3089\u308c\u308b\u3079\u304d\u3060\uff0e</p> <p>\u3057\u305f\u304c\u3063\u3066\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u306a\u3089\u3070\uff0c\u653f\u6cbb\u793e\u4f1a\u306e\u69cb\u6210\u54e1\u3092\u4eba\u9593\u306b\u9650\u5b9a\u3059\u308b\u5fc5\u8981\u306f\u306a\u304f\u306a\u308b\uff0e\u4eba\u9593\u3068\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u3068\u3082\u306b\u793e\u4f1a\u5951\u7d04\u3092\u884c\u3044\uff0c\u653f\u6cbb\u793e\u4f1a\u3092\u69cb\u6210\u3059\u308b\u306e\u3067\u3042\u308b\uff0e\u3053\u306e\u610f\u5473\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u8a8d\u3081\u308b\u3053\u3068\u306f\uff0c\u4eba\u9593\u3060\u3051\u306b\u3088\u3063\u3066\u69cb\u6210\u3055\u308c\u3066\u304d\u305f\u653f\u6cbb\u793e\u4f1a\u3092\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u542b\u3080\u5f62\u3078\u3068\u62e1\u5f35\u3059\u308b\u3053\u3068\u3060\u3068\u3044\u3048\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_11","title":"\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3068\u3057\u3066\u306e\u6a29\u5229","text":"<p>\u524d\u7bc0\u3067\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u8a8d\u3081\u308b\u3053\u3068\u306b\u3088\u3063\u3066\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3082\u307e\u305f\u653f\u6cbb\u793e\u4f1a\u306e\u69cb\u6210\u54e1\u306b\u306a\u308b\u306e\u3060\u3068\u8003\u3048\u305f\uff0e\u3067\u306f\uff0c\u4e00\u5ea6\u305d\u306e\u3088\u3046\u306b\u793e\u4f1a\u306e\u69cb\u6210\u54e1\u3068\u3057\u3066\u8a8d\u3081\u305f\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\uff0c\u5f8c\u304b\u3089\u4eba\u9593\u306e\u5224\u65ad\u306b\u3088\u308a\u793e\u4f1a\u304b\u3089\u6392\u9664\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3060\u308d\u3046\u304b\uff0e</p> <p>\u3053\u306e\u554f\u984c\u306f\uff0c\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u304a\u3051\u308b\u62b5\u6297\u6a29\u306e\u67a0\u7d44\u307f\u304b\u3089\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u308b\uff0e</p> <p>\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u304c\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3067\u3042\u308b\u306a\u3089\u3070\uff0c\u305d\u306e\u6a29\u5229\u306f\u793e\u4f1a\u5951\u7d04\u306e\u67a0\u7d44\u307f\u306b\u3088\u308a\u76f8\u4e92\u306b\u4fdd\u969c\u3055\u308c\u308b\u3079\u304d\u3067\u3042\u308b\uff0e\u3057\u305f\u304c\u3063\u3066\uff0c\u793e\u4f1a\u304c\u305d\u306e\u6a29\u5229\u3092\u4fb5\u5bb3\u3059\u308b\u3053\u3068\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4e0d\u5229\u76ca\u3092\u4e0e\u3048\u308b\u3068\u3044\u3046\u3060\u3051\u3067\u306a\u304f\uff0c\u793e\u4f1a\u5951\u7d04\u4e0a\u306e\u7fa9\u52d9\u306b\u9055\u53cd\u3059\u308b\u3053\u3068\u3068\u306a\u308b\uff0e</p> <p>\u793e\u4f1a\u5951\u7d04\u8aac\u306e\u3046\u3061\uff0c\u3053\u306e\u3088\u3046\u306a\u5951\u7d04\u9055\u53cd\u306b\u5bfe\u3059\u308b\u62b5\u6297\u6a29\u3092\u8a8d\u3081\u308b\u7acb\u5834\u3092\u3068\u308b\u306e\u3067\u3042\u308c\u3070\uff0c\u305d\u306e\u6a29\u5229\u306f\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u3082\u8a8d\u3081\u3089\u308c\u308b\u306f\u305a\u3067\u3042\u308b\uff0e\u306a\u305c\u306a\u3089\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306f\u4eba\u9593\u3068\u540c\u3058\u304f\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3068\u3057\u3066\u653f\u6cbb\u793e\u4f1a\u3092\u69cb\u6210\u3057\u3066\u3044\u308b\u304b\u3089\u3067\u3042\u308b\uff0e \u3053\u308c\u306f\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u7279\u5225\u306b\u62b5\u6297\u6a29\u3092\u8a8d\u3081\u308b\u3068\u3044\u3046\u610f\u5473\u3067\u306f\u306a\u3044\uff0e\u4eba\u9593\u3060\u3051\u306e\u653f\u6cbb\u793e\u4f1a\u3092\u524d\u63d0\u3068\u3057\u305f\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u304a\u3051\u308b\u62b5\u6297\u6a29\u306e\u6982\u5ff5\u304c\uff0c\u4eba\u9593\u4ee5\u5916\u3092\u542b\u3080\u653f\u6cbb\u793e\u4f1a\u3078\u3068\u62e1\u5f35\u3055\u308c\u305f\u306b\u3059\u304e\u306a\u3044\uff0e</p> <p>\u3057\u305f\u304c\u3063\u3066\uff0c\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u308b\u300d\u3068\u3044\u3046\u3053\u3068\u306f\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u4eba\u9593\u3068\u3068\u3082\u306b\u653f\u6cbb\u793e\u4f1a\u3092\u69cb\u6210\u3059\u308b\u793e\u4f1a\u5951\u7d04\u306e\u5f53\u4e8b\u8005\u3068\u3057\u3066\u8a8d\u3081\u308b\u3053\u3068\u3067\u3042\u308b\uff0e\u305d\u3057\u3066\u305d\u306e\u7d50\u679c\u3068\u3057\u3066\uff0c\u793e\u4f1a\u5951\u7d04\u306b\u3088\u308a\u4fdd\u969c\u3055\u308c\u308b\u6a29\u5229\u3084\uff0c\u5951\u7d04\u304c\u4fb5\u5bb3\u3055\u308c\u305f\u5834\u5408\u306b\u305d\u306e\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u304a\u3044\u3066\u8a8d\u3081\u3089\u308c\u308b\u62b5\u6297\u6a29\u306b\u3064\u3044\u3066\u3082\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u305d\u306e\u4e3b\u4f53\u3068\u3057\u3066\u6271\u3046\u3053\u3068\u3068\u306a\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_12","title":"\u307e\u3068\u3081","text":"<p>\u3053\u306e\u8a18\u4e8b\u3067\u306f\uff0c\u6a29\u5229\u306e\u5b58\u5728\u3068\u305d\u306e\u793e\u4f1a\u7684\u4fdd\u969c\u3092\u533a\u5225\u3057\uff0c\u3055\u3089\u306b\u6a29\u5229\u306e\u4e3b\u4f53\u3068\u306a\u308b\u3053\u3068\u3068\u6a29\u5229\u3092\u884c\u4f7f\u3059\u308b\u80fd\u529b\u3092\u533a\u5225\u3059\u308b\u3053\u3068\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3078\u306e\u4eba\u6a29\u4fdd\u969c\u3092\u81ea\u7136\u6a29\u306e\u67a0\u7d44\u307f\u306e\u4e2d\u306b\u4f4d\u7f6e\u3065\u3051\u305f\uff0e\u307e\u305f\uff0c\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3092\u4eba\u9593\u3067\u3042\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u9650\u5b9a\u305b\u305a\uff0c\u5951\u7d04\u3092\u7406\u89e3\u3057\uff0c\u81ea\u3089\u306e\u610f\u601d\u306b\u3088\u3063\u3066\u4ed6\u8005\u3068\u306e\u95a2\u4fc2\u3092\u69cb\u7bc9\u3059\u308b\u80fd\u529b\u3092\u6301\u3064\u3053\u3068\u3092\u6761\u4ef6\u3068\u3059\u308b\u3053\u3068\u3067\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u4f4d\u7f6e\u3065\u3051\u305f\uff0e</p> <p>\u3053\u306e\u3088\u3046\u306b\u3057\u3066\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3078\u306e\u4eba\u6a29\u4fdd\u969c\u3092\u8a8d\u3081\u306a\u304c\u3089\u3082\uff0c\u4eba\u6a29\u3092\u81ea\u7136\u6a29\u3068\u3057\u3066\u6349\u3048\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u3092\u793e\u4f1a\u5951\u7d04\u306e\u4e3b\u4f53\u3068\u3057\u3066\u4f4d\u7f6e\u3065\u3051\u308b\u3053\u3068\u306b\u3088\u3063\u3066\uff0c\u81ea\u7136\u6a29\u8ad6\u3068\u793e\u4f1a\u5951\u7d04\u8aac\u3092\u7dad\u6301\u3059\u308b\u30e2\u30c7\u30eb\u3092\u69cb\u6210\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305f\uff0e\u305f\u3060\u3057\uff0c\u3053\u306e\u30e2\u30c7\u30eb\u306f\uff0c\u4efb\u610f\u306e\u5bfe\u8c61\u304c\u81ea\u7136\u6a29\u3068\u3057\u3066\u306e\u4eba\u6a29\u3092\u6709\u3059\u308b\u3068\u3044\u3046\u5f37\u3044\u4eee\u5b9a\u306e\u4e0a\u306b\u69cb\u6210\u3055\u308c\u305f\u3082\u306e\u3067\u3042\u308b\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_13","title":"\u8b1d\u8f9e","text":"<p>\u3053\u306e\u8a18\u4e8b\u306e\u8003\u5bdf\u306f\uff0c\u30ab\u30cb\u306b\u306a\u308a\u305f\u304b\u3063\u305f\u30ab\u30cb\u30ab\u30de\u6c0f\u306e\u30c4\u30a4\u30fc\u30c8\u3092\u304d\u3063\u304b\u3051\u3068\u3057\u3066\u3044\u308b\uff0e\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306e\u4eba\u6a29\u3068\u3044\u3046\u30c6\u30fc\u30de\u304b\u3089\u81ea\u7136\u6a29\u3068\u793e\u4f1a\u5951\u7d04\u306b\u3064\u3044\u3066\u8003\u3048\u3089\u308c\u308b\uff0c\u8208\u5473\u6df1\u3044\u554f\u984c\u63d0\u8d77\u3092\u3057\u3066\u3044\u305f\u3060\u3044\u305f\u3053\u3068\u306b\u611f\u8b1d\u3057\u305f\u3044\uff0e</p>"},{"location":"posts/2026/09/voiceroid-rights/#_14","title":"\u3042\u3068\u304c\u304d","text":"<p>\u3086\u3093\u3060\u3088\uff0e</p> <p>\u601d\u8003\u3092\u8a00\u8a9e\u5316\u3057\u3066\u771f\u9762\u76ee\u306a\u6587\u7ae0\u306b\u843d\u3068\u3059\u306e\u306f\u75b2\u308c\u308b\u306d\uff0e</p> <p>\u3053\u306e\u6587\u7ae0\u306f\uff0c\u5143\u30c4\u30a4\u30fc\u30c8\u306e\u61f8\u5ff5\u3092\u56de\u907f\u3057\u3064\u3064\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u3089\u308c\u308b\u3088\u3046\u306a\u7406\u8ad6\u30e2\u30c7\u30eb\u3092\u69cb\u6210\u3057\u305f\u3064\u3082\u308a\u3060\u3088\uff0e</p> <p>\u78ba\u304b\u306b\u30ed\u30c3\u30af\u306e\u69cb\u9020\u306f\u57fa\u306b\u3057\u305f\u3051\u3069\uff0c\u81ea\u7136\u6a29\u306e\u4e00\u822c\u5316\uff08\u3068\u3044\u3046\u3088\u308a\u3082\u666e\u904d\u5316\u304b\u3082\uff09\u3068\u3044\u3046\u3067\u3063\u304b\u3044\u516c\u7406\u3092\u5165\u308c\u305f\u308a\u3057\u3061\u3083\u3063\u305f\u304b\u3089\uff0c\u65e2\u5b58\u306e\u793e\u4f1a\u5951\u7d04\u8aac\u3068\u6df7\u3056\u3089\u306a\u3044\u3088\u3046\u306b\u300c\u3086\u3093\u578b\u793e\u4f1a\u5951\u7d04\u8aac\u300d\u3068\u547c\u3093\u3058\u3083\u3046\u307b\u3046\u304c\u3044\u3044\u304b\u3082\uff1f</p> <p>\u3053\u306e\u3068\u304d\uff0c\u3053\u306e\u8a18\u4e8b\u306f\u300c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u308b\u3053\u3068\u3067\u81ea\u7136\u6a29\u304c\u76f8\u5bfe\u5316\u3055\u308c\u308b\u300d\u3068\u3044\u3046\u5143\u30c4\u30a4\u30fc\u30c8\u306e\u554f\u984c\u63d0\u8d77\u306f\uff0c\u3086\u3093\u578b\u793e\u4f1a\u5951\u7d04\u8aac\u306e\u67a0\u7d44\u307f\u3067\u306f\u751f\u3058\u306a\u3044\uff0c\u3068\u4e3b\u5f35\u3057\u305f\u3053\u3068\u306b\u306a\u308b\u304b\u306a\uff0e</p> <p>\u3082\u3061\u308d\u3093\u3086\u3093\u578b\u793e\u4f1a\u5951\u7d04\u8aac\u306b\u7a74\u304c\u306a\u3044\u306a\u3093\u3066\u601d\u3063\u3066\u306a\u3044\u3088\uff0e\u305f\u3076\u3093\u3044\u3063\u3071\u3044\u3042\u308b\uff0e</p> <p>\u611f\u60f3\u3084\u6307\u6458\u3068\u304b\u306f\u3086\u3093\u306eTwitter(X)\u304b\u30de\u30b7\u30e5\u30de\u30ed\u306b\u9001\u3063\u3066\u306d\uff0e\u3042\u306a\u305f\u306e\u6307\u6458\u3067\u3086\u3093\u578b\u793e\u4f1a\u5951\u7d04\u8aac\u3092\u5f37\u56fa\u306b\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3057\uff0c\u5d29\u58ca\u3055\u305b\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3088\uff0e</p> <p>\u3042\u3068\u306f\u305d\u3046\u3060\u306a\u2026</p> <p>\u6b63\u76f4\uff0c\u30dc\u30a4\u30b9\u30ed\u30a4\u30c9\u306b\u4eba\u6a29\u3092\u8a8d\u3081\u306a\u304f\u3066\u3082\u3044\u3044\u3093\u3058\u3083\u306a\u3044\u304b\u306a\uff1f</p>"}]}